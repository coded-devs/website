# Copy values into the matching Coolify service; never commit real values.

# Web service (apps/web)
NODE_ENV=production
PORT=3000
SITE_URL=https://codeddevs.org
# Private API origin on the shared Coolify network; set to the verified API resource alias.
API_URL=
CONTENT_REVALIDATION_SECRET=

# Admin service (apps/admin)
PORT=3001
# Private API origin on the shared Coolify network; set to the verified API resource alias.
API_INTERNAL_ORIGIN=

# API service (apps/api)
PORT=4000
ADMIN_ORIGIN=https://admin.codeddevs.org
WEB_INTERNAL_ORIGIN=https://codeddevs.org
# Leave blank until the private Web/Admin -> API HTTP path is verified.
# With current header normalization, use 1 only if the frontend directly calls the API.
API_TRUST_PROXY_HOPS=
AUTH_THROTTLE_HMAC_SECRET=
CONTENT_REVALIDATION_SECRET=
DATABASE_URL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# PostgreSQL Coolify resource (private, persistent volume; never publish 5432)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
