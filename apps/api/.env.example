NODE_ENV=development
PORT=4000
ADMIN_ORIGIN=http://localhost:3001
API_TRUST_PROXY_HOPS=0
DATABASE_URL=postgresql://user:password@localhost:5432/codeddevs
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/codeddevs_test

# Production requires an HTTPS ADMIN_ORIGIN and an explicit positive
# API_TRUST_PROXY_HOPS value matching the verified proxy path.

# Required by the explicit `pnpm --filter @codeddevs/api db:migrate` command.
# Migrations are never run when the API instance starts.
# TEST_DATABASE_URL must point to a disposable database whose name contains
# "test" as a separate segment (for example, codeddevs_test or test-db); the
# database test suite resets its public and Drizzle schemas.
