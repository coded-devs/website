NODE_ENV=development
PORT=4000
ADMIN_ORIGIN=http://localhost:3001
API_TRUST_PROXY_HOPS=0
WEB_INTERNAL_ORIGIN=http://localhost:3000
# CONTENT_REVALIDATION_SECRET=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_BASE_URL=
DATABASE_URL=postgresql://user:password@localhost:5432/codeddevs
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/codeddevs_test

# PORT must be an integer from 1 to 65535. Production API startup requires a
# valid PostgreSQL DATABASE_URL. Keep actual database credentials and the
# AUTH_THROTTLE_HMAC_SECRET value in a secret manager, never in this example.

# Production requires an HTTPS ADMIN_ORIGIN and an explicit positive
# API_TRUST_PROXY_HOPS value matching the verified proxy path.
# Production also requires HTTPS WEB_INTERNAL_ORIGIN and a shared 32-byte
# hexadecimal CONTENT_REVALIDATION_SECRET configured in API and Web.
# Production media storage requires all R2 variables above. Keep credentials
# in the API server's secret manager; the public base URL is read-only delivery.

# Required by the explicit `pnpm --filter @codeddevs/api db:migrate` command.
# Migrations are never run when the API instance starts.
# TEST_DATABASE_URL must point to a disposable database whose name contains
# "test" as a separate segment (for example, codeddevs_test or test-db); the
# database test suite resets its public and Drizzle schemas.
